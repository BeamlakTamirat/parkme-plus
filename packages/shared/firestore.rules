rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superAdmin'];
    }
    
    function isAttendant() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'attendant';
    }
    
    function isAdminOrAttendant() {
      return isAdmin() || isAttendant();
    }
    
    function isValidUser() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active == true;
    }
    
    function isValidEmail() {
      return request.auth.token.email_verified == true;
    }
    
    function isResourceOwner(resource) {
      return isAuthenticated() && resource.data.user_id == request.auth.uid;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdminOrAttendant());
      allow create: if isAuthenticated() && isOwner(userId) && isValidData();
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin()) && isValidData();
      allow delete: if isAdmin();
      
      function isValidData() {
        let data = request.resource.data;
        return data.keys().hasAll(['email', 'full_name', 'role']) &&
               data.email is string &&
               data.full_name is string &&
               data.role in ['user', 'admin', 'attendant', 'superAdmin'] &&
               (isOwner(userId) ? data.role == 'user' : true);
      }
      
      // User stats subcollection
      match /user_stats/{statId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
    
    // Parking locations collection
    match /parking_locations/{locationId} {
      allow read: if isValidUser();
      allow create, update, delete: if isAdmin();
      
      // Location amenities subcollection
      match /amenities/{amenityId} {
        allow read: if isValidUser();
        allow write: if isAdmin();
      }
      
      // Spot availability subcollection
      match /availability/{availabilityId} {
        allow read: if isValidUser();
        allow write: if isAdminOrAttendant();
      }
    }
    
    // Parking spots collection
    match /parking_spots/{spotId} {
      allow read: if isValidUser();
      allow create, update, delete: if isAdmin();
      allow update: if isAdminOrAttendant() && 
                       request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['status', 'updated_at']);
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isValidUser() && (isResourceOwner(resource) || isAdminOrAttendant());
      allow create: if isAuthenticated() && isValidBooking();
      allow update: if isAuthenticated() && 
                       (isResourceOwner(resource) || isAdminOrAttendant()) && 
                       isValidBookingUpdate();
      allow delete: if isAdmin();
      
      function isValidBooking() {
        let data = request.resource.data;
        return data.user_id == request.auth.uid &&
               data.keys().hasAll(['parking_location_id', 'parking_spot_id', 'vehicle_id', 
                                  'start_time', 'end_time', 'total_amount']) &&
               data.start_time is timestamp &&
               data.end_time is timestamp &&
               data.start_time < data.end_time &&
               data.total_amount is number &&
               data.total_amount > 0;
      }
      
      function isValidBookingUpdate() {
        let data = request.resource.data;
        let allowedFields = isResourceOwner(resource) ? 
          ['status', 'updated_at'] : 
          ['status', 'check_in_time', 'check_out_time', 'updated_at'];
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(allowedFields);
      }
      
      // Booking history subcollection
      match /booking_history/{historyId} {
        allow read: if isResourceOwner(get(/databases/$(database)/documents/bookings/$(bookingId))) || 
                       isAdminOrAttendant();
        allow create: if isAdminOrAttendant();
      }
    }
    
    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read, write: if isValidUser() && isResourceOwner(resource);
      allow read: if isAdminOrAttendant();
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if isValidUser() && (isResourceOwner(resource) || isAdminOrAttendant());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdminOrAttendant() || 
                       (isResourceOwner(resource) && 
                        request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['status', 'updated_at']));
      
      // Payment history subcollection
      match /payment_history/{historyId} {
        allow read: if isResourceOwner(get(/databases/$(database)/documents/payments/$(paymentId))) || 
                       isAdminOrAttendant();
        allow create: if isAdminOrAttendant();
      }
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isValidUser() && isResourceOwner(resource);
      allow create: if isAdminOrAttendant();
      allow update: if isValidUser() && isResourceOwner(resource) && 
                       request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['is_read', 'read_at', 'updated_at']);
    }
    
    // Reviews collection
    match /reviews/{reviewId} {
      allow read: if isValidUser();
      allow create: if isAuthenticated() && 
                       request.resource.data.user_id == request.auth.uid &&
                       isValidReview();
      allow update: if isResourceOwner(resource) && isValidReviewUpdate();
      allow delete: if isResourceOwner(resource) || isAdmin();
      
      function isValidReview() {
        let data = request.resource.data;
        return data.keys().hasAll(['parking_location_id', 'rating', 'comment']) &&
               data.rating is number &&
               data.rating >= 1 &&
               data.rating <= 5 &&
               data.comment is string;
      }
      
      function isValidReviewUpdate() {
        return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rating', 'comment', 'updated_at']);
      }
    }
    
    // Analytics collection (Admin only)
    match /analytics/{analyticsId} {
      allow read, write: if isAdmin();
    }
    
    // Settings collection (Admin only)
    match /settings/{settingId} {
      allow read: if isValidUser();
      allow write: if isAdmin();
    }
    
    // Incident reports collection
    match /incident_reports/{reportId} {
      allow read: if isAdminOrAttendant() || isResourceOwner(resource);
      allow create: if isAuthenticated() && 
                       request.resource.data.user_id == request.auth.uid;
      allow update: if isAdminOrAttendant();
    }
    
    // Block all other document access
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 